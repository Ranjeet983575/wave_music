{
  "expo": {
    "name": "Wave Music",
    "slug": "wave_music",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "extra": {
      "eas": {
        "projectId": "9fb14626-c607-44fb-a7a3-35d8bd840022"
      }
    },
    "ios": {
      "bundleIdentifier": "com.ranjeet983575.wave_music",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ranjeet983575.wave_music"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": false,
          "granularPermissions": [
            "audio"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101412",
          "android": {
            "backgroundColor": "#101412"
          },
          "ios": {
            "backgroundColor": "#101412"
          }
        }
      ],
      "expo-status-bar"
    ]
  }
}